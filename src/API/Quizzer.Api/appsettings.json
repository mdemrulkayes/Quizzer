{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Elastic.Serilog.Sinks"
    ],
    "WriteTo": [
      {
        "Name": "Debug"
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u3}] ({Application}/{MachineName}/{ThreadId}) {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "outputTemplate": "{Timestamp:o} [{Level:u3}] ({Application}/{MachineName}/{ThreadId}) {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "bootstarpMethod": "Silent",
          "nodes": [
            "http://elastichost:9200"
          ],
          "ilmPolicy": "quizzer-policy",
          "dataStream": "quizzer",
          "includeHost": true,
          "includeUser": true,
          "includeProcess": true,
          "includeActivity": true
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "ConnectionStrings": {
    "IdentityModuleDbContext": "",
    "QuestionModuleDbContext": "",
    "ExamModuleDbContext": "",
    "Redis": "localhost:6379"
  },
  "JwtConfiguration": {
    "JwtIssuer": "https://quizzer.api",
    "JwtAudience": "https://quizzer.api",
    "JwtKey": "d730897473419d1e76189efe498ecd397e812be39fde2a68f9c6a245cf9f9ab5",
    "JwtExpireDay": 1
  },
  "DefaultUser": {
    "FirstName": "Default",
    "LastName": "Super Admin",
    "PhoneNumber": "457455141",
    "Email": "default_super_admin@quizzer.com",
    "password": "ChangeMe@123"
  }
}
